# Linux / WSL2 with a working NVIDIA driver. Copy to .env.
DATABASE_URL=postgresql://megan:megan@127.0.0.1:54329/megan
ASR_BACKEND=faster_whisper
ASR_MODEL_PATH=models/whisper-turbo-ct2
ASR_DEVICE=cuda
ASR_COMPUTE_TYPE=int8_float16
ASR_LANGUAGE=auto
OLLAMA_BASE_URL=http://127.0.0.1:11435
OLLAMA_MODEL=qwen3.5:4b
LLM_TOKENIZER_PATH=models/qwen3.5-tokenizer/tokenizer.json
# 32K measured on the RTX 4060: peak 4893 MiB of 8188 during a 25-minute Russian meeting,
# with no slowdown on short ones. Roughly doubles capacity (RU 22->53 min, KK 16->38 min), so
# MAX_DURATION_SEC becomes the single binding limit instead of the context window.
LLM_CONTEXT=32768
LLM_OUTPUT_TOKENS=3500
DIARIZATION_BACKEND=none
# Optional third model; follow docs/DIARIZATION.md before enabling sortformer_nemo.
DIARIZATION_MODEL_PATH=models/diar_streaming_sortformer_4spk-v2.nemo
# DIARIZATION_PYTHON=/absolute/path/to/nemo-environment/bin/python
DIARIZATION_DEVICE=cuda
DATA_DIR=data
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
HF_HUB_DISABLE_TELEMETRY=1
