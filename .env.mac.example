# Copy to .env. Run all commands from the repository root.
DATABASE_URL=postgresql://megan:megan@127.0.0.1:54329/megan
ASR_BACKEND=whisper_cpp
ASR_MODEL_PATH=models/ggml-large-v3-turbo.bin
WHISPER_CPP_BIN=whisper-cli
ASR_LANGUAGE=auto
OLLAMA_BASE_URL=http://127.0.0.1:11435
OLLAMA_MODEL=qwen3.5:4b
LLM_CONTEXT=16384
LLM_OUTPUT_TOKENS=3500
DIARIZATION_BACKEND=none
# Optional third model; follow docs/DIARIZATION.md before enabling sortformer_cpp.
DIARIZATION_MODEL_PATH=models/diar_streaming_sortformer_4spk-v2.q8_0.gguf
NEMO_SPEECH_BIN=.local/nemo-speech/bin/nemo-speech
DIARIZATION_DEVICE=metal
DATA_DIR=data
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
HF_HUB_DISABLE_TELEMETRY=1
