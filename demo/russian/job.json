  "segments": [
    {
      "id": "S1",
      "start": 0.0,
      "end": 2.26,
      "text": "Это контрольная запись рабочей встречи.",
      "speaker_id": "speaker_0",
      "language": "ru"
    },
    {
      "id": "S2",
      "start": 2.58,
      "end": 7.0,
      "text": "Мы обсуждаем подготовку демонстрации приложения для протоколов совещаний.",
      "speaker_id": "speaker_0",
      "language": "ru"
    },
    {
      "id": "S3",
      "start": 7.36,
      "end": 9.82,
      "text": "Сначала уточним, что уже готово.",
      "speaker_id": "speaker_0",
      "language": "ru"
    },
    {
      "id": "S4",
      "start": 10.16,
      "end": 14.18,
      "text": "Дана уже закончила оформление отчета и вчера отправила пример команде.",
      "speaker_id": "speaker_0",
      "language": "ru"
    },
    {
      "id": "S5",
      "start": 14.48,
      "end": 17.88,
      "text": "Это выполненная работа, повторно назначать ее не нужно.",
      "speaker_id": "speaker_0",
      "language": "ru"
    },
    {
      "id": "S6",
      "start": 18.26,
      "end": 20.42,
      "text": "Теперь договоримся о следующих шагах.",
      "speaker_id": "speaker_0",
      "language": "ru"
    },
    {
      "id": "S7",
      "start": 20.42,
      "end": 23.82,
      "text": "Дана подготовит инструкцию по запуску к понедельнику.",
      "speaker_id": "speaker_0",
      "language": "ru"
    },
    {
      "id": "S8",
      "start": 24.14,
      "end": 30.1,
      "text": "Исправляю срок, не к понедельнику, а к 18 сентября 2026 года.",
      "speaker_id": "speaker_0",
      "language": "ru"
    },
    {
      "id": "S9",
      "start": 30.44,
      "end": 33.86,
      "text": "В инструкции нужны команды запуска и порядок проверки звука.",
      "speaker_id": "speaker_0",
      "language": "ru"
    },
    {
      "id": "S10",
      "start": 34.24,
      "end": 36.2,
      "text": "Других задач для Даны сегодня нет.",
      "speaker_id": "speaker_0",
      "language": "ru"
    },
    {
      "id": "S11",
      "start": 36.52,
      "end": 41.5,
      "text": "Если проверка базы данных пройдет успешно, Айдар проверит экспорт отчета завтра.",
      "speaker_id": "speaker_0",
      "language": "ru"
    },
    {
      "id": "S12",
      "start": 41.84,
      "end": 44.3,
      "text": "Это конкретное условное поручение Айдару.",
      "speaker_id": "speaker_0",
      "language": "ru"
    },
    {
      "id": "S13",
      "start": 44.3,
      "end": 48.32,
      "text": "Проверка базы данных – единственное условие для этой задачи.",
      "speaker_id": "speaker_0",
      "language": "ru"
    },
    {
      "id": "S14",
      "start": 48.6,
      "end": 51.54,
      "text": "Мы решили проводить демонстрацию на русском языке.",
      "speaker_id": "speaker_0",
      "language": "ru"
    },
    {
      "id": "S15",
      "start": 51.86,
      "end": 57.6,
      "text": "Микрофон пока не выбрали, использовать встроенный или внешний, остается открытым вопросом.",
      "speaker_id": "speaker_0",
      "language": "ru"
    },
    {
      "id": "S16",
      "start": 57.92,
      "end": 60.7,
      "text": "Мы сегодня никому не поручали покупать микрофон.",
      "speaker_id": "speaker_0",
      "language": "ru"
    },
    {
      "id": "S17",
      "start": 61.04,
      "end": 67.36,
      "text": "Для примера можно представить, что кто-то заказывает новое оборудование, но это только гипотетический пример.",
      "speaker_id": "speaker_0",
      "language": "ru"
    },
    {
      "id": "S18",
      "start": 67.72,
      "end": 69.18,
      "text": "Повторю результат встречи.",
      "speaker_id": "speaker_0",
      "language": "ru"
    },
    {
      "id": "S19",
      "start": 69.46,
      "end": 72.78,
      "text": "Инструкция остается задачей даны с исправленным сроком.",
      "speaker_id": "speaker_0",
      "language": "ru"
    },
    {
      "id": "S20",
      "start": 72.78,
      "end": 75.74,
      "text": "Экспорт проверит Айдар при указанном условии.",
      "speaker_id": "speaker_0",
      "language": "ru"
    },
    {
      "id": "S21",
      "start": 76.04,
      "end": 78.06,
      "text": "Оформление отчета уже закончено.",
      "speaker_id": "speaker_0",
